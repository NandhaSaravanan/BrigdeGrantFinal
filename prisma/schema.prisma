// Generated by scripts/build_database.py to match data/processed/bridgegrant.db.
// To check it against the real database instead: npx prisma db pull
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/processed/bridgegrant.db"
}

model funders {
  id                          Int      @id @default(autoincrement())
  funder_ein                  String?  @unique
  funder_name                 String
  funder_state                String?
  funder_form_type            String?
  funder_type                 String
  years_active                String?
  first_year                  Int?
  last_year                   Int?
  grants_all_types            Int
  total_amount_all_types      Float
  standard_grants             Int
  standard_total_amount       Float
  standard_median_grant       Float?
  standard_p25_grant          Float?
  standard_p75_grant          Float?
  standard_sc_recipients      Int
  counties_served             String?
  counties_served_count       Int
  share_dollars_matching_gift Float
  share_dollars_individual    Float
  share_dollars_in_kind       Float
  likely_open_to_applicants   Boolean
  rank_standard_grants        Int?
  grants                      grants[]

  @@index([funder_ein], map: "idx_funders_funder_ein")
}

model recipients {
  id                          Int      @id @default(autoincrement())
  recipient_key               String   @unique
  recipient_ein               String?
  recipient_name              String?
  recipient_name_clean        String?
  recipient_type              String?
  recipient_city              String?
  recipient_zip               String?
  recipient_county            String?
  county_status               String?
  recipient_identity_verified Boolean
  recipient_exemption_revoked Boolean
  grants                      grants[]

  @@index([recipient_ein], map: "idx_recipients_recipient_ein")
  @@index([recipient_zip], map: "idx_recipients_recipient_zip")
  @@index([recipient_county], map: "idx_recipients_recipient_county")
}

model grants {
  id                          Int      @id @default(autoincrement())
  record_id                   String   @unique
  funder_id                   Int
  recipient_id                Int
  funder_ein                  String?
  recipient_ein               String?
  tax_year                    Int
  tax_year_status             String
  filing_id                   String
  is_amended_return           Boolean
  recipient_name              String?
  recipient_street_address    String?
  recipient_city              String?
  recipient_state             String
  recipient_zip               String?
  recipient_county            String?
  county_status               String
  county_candidates           String?
  cash_amount                 Float?
  noncash_amount              Float?
  grant_amount                Float
  is_mostly_noncash           Boolean
  grant_purpose               String?
  grant_type                  String
  recipient_type              String
  funder_type                 String
  source_type                 String
  source_table                String
  source_url                  String?
  source_table_match          Boolean
  irs_filing_check            String
  irs_filing_verified         Boolean
  recipient_identity_verified Boolean
  sc_address_verified         Boolean
  county_verified             Boolean
  recipient_exemption_revoked Boolean
  verification_status         String
  funder                      funders    @relation(fields: [funder_id], references: [id])
  recipient                   recipients @relation(fields: [recipient_id], references: [id])
  evidence                    verification_evidence[]

  @@index([funder_ein], map: "idx_grants_funder_ein")
  @@index([recipient_ein], map: "idx_grants_recipient_ein")
  @@index([tax_year], map: "idx_grants_tax_year")
  @@index([grant_amount], map: "idx_grants_grant_amount")
  @@index([recipient_county], map: "idx_grants_recipient_county")
  @@index([recipient_zip], map: "idx_grants_recipient_zip")
  @@index([funder_id], map: "idx_grants_funder_id")
  @@index([recipient_id], map: "idx_grants_recipient_id")
}

model verification_evidence {
  id         Int    @id @default(autoincrement())
  grant_id   Int
  record_id  String
  check_name String
  source_url String?
  check_date String
  result     String
  notes      String?
  grant      grants @relation(fields: [grant_id], references: [id])

  @@index([grant_id], map: "idx_evidence_grant_id")
  @@index([check_name], map: "idx_evidence_check_name")
}
